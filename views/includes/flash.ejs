<!-- For Success -->
<% if (success && success.length) { %>
    <div class="alert alert-success alert-dismissible fade show col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3 mt-3 mb-2" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>
        <span><%= success %></span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<!-- For Failure -->
<% if (error && error.length) { %>
    <div class="alert alert-danger alert-dismissible fade show col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3 mt-3 mb-2" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i>
        <span><%= error %></span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>