<%- layout("/layouts/boilerplate.ejs") %>

<div class="row mt-5 mb-5">
    <div class="col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3">
        <div class="card form-card text-center py-4">
            <div class="mb-3">
                <i class="fa-solid fa-triangle-exclamation text-danger display-4"></i>
            </div>
            <h3 class="fw-bold mb-2">Something went wrong</h3>
            <p class="text-secondary mb-4"><%= err.message %></p>
            <div>
                <a href="/listings" class="btn btn-teal">
                    <i class="fa-solid fa-arrow-left me-1"></i> Return to Explore
                </a>
            </div>
        </div>
    </div>
</div>
