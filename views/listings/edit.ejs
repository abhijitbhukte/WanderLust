<% layout("/layouts/boilerplate") %>
<div class="row">
    <div class="col-8 offset-2">
        <body>
    <h3>Edit Listing</h3>
    <form method="POST" action="/listings/<%= listing._id%>?_method=PUT" novalidate class="needs-validation">
        <div class="mb-3">
             <lable for="title" class="form-label">Title</lable>
            <input name="listing[title]" value="<%=listing.title%>" type="text" class="form-control required"/>
            <div class="valid-feedback">Title Looks Good!</div>
            <div class="invalid-feedback">Please enter valid Title</div>
        </div>
        <div>
             <lable for="describtion" class="form-label">Describtion</lable>
            <textarea name="listing[description]" class="form-control" required><%=listing.description%></textarea>
            <div class="invalid-feedback">Please enter valid Describtion</div>
        </div>
        <div>
            <lable for="image" class="form-label">Image</lable>
            <input name="listing[image][url]" value="<%=listing.image.url%>" type="text" class="form-control"/>
        </div>
        <div class="row">
            <div class="mb-3 col-md-4">
            <lable for="price" class="form-label">Price</lable>
            <input name="listing[price]" value="<%=listing.price%>"  class="form-control" required/>
            <div class="invalid-feedback">Please enter valid Price</div>
        </div>
        <div class="mb-3 col-md-8">
            <lable for="Country" class="form-label">Country</lable>
            <input name="listing[country]" value="<%=listing.country%>" type="text" class="form-control" required/>
            <div class="invalid-feedback">Please enter valid Country</div>
       </div>
        </div>
        
        
        <div>
            <lable for="location" class="form-label">Location</lable>
             <input name="listing[location]" value="<%=listing.location%>" type="text" class="form-control" required/>
             <div class="invalid-feedback">Please enter valid Location</div>
        </div>
       
        <button class="btn btn-dark edit-btn mt-3">Edit</button>      
    </form>
</body>

    </div>
</div>
<script src="/js/script.js"></script>