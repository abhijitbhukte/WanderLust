<% layout("/layouts/boilerplate") %>

<div id="filters" class="mb-3">
    <div class="filter active">
        <i class="fa-solid fa-fire"></i>
        <p>Trending</p>
    </div>
    <div class="filter">
        <i class="fa-solid fa-bed"></i>
        <p>Rooms</p>
    </div>
    <div class="filter">
        <i class="fa-solid fa-mountain-city"></i>
        <p>Iconic cities</p>
    </div>
    <div class="filter">
        <i class="fa-solid fa-mountain"></i>
        <p>Mountains</p>
    </div>
    <div class="filter d-none d-sm-flex flex-column align-items-center">
        <i class="fa-solid fa-fort-awesome"></i>
        <p>Castles</p>
    </div>
    <div class="filter d-none d-md-flex flex-column align-items-center">
        <i class="fa-solid fa-person-swimming"></i>
        <p>Pools</p>
    </div>
    <div class="filter d-none d-lg-flex flex-column align-items-center">
        <i class="fa-solid fa-campground"></i>
        <p>Camping</p>
    </div>
    <div class="filter d-none d-lg-flex flex-column align-items-center">
        <i class="fa-solid fa-cow"></i>
        <p>Farms</p>
    </div>
    <div class="filter d-none d-xl-flex flex-column align-items-center">
        <i class="fa-solid fa-snowflake"></i>
        <p>Arctic</p>
    </div>
    <div class="filter d-none d-xl-flex flex-column align-items-center">
        <i class="fa-solid fa-ship"></i>
        <p>Boats</p>
    </div>

    <div class="tax-toggle ms-auto d-none d-lg-flex">
        <div class="form-check form-switch form-check-reverse m-0">
            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
            <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
        </div>
    </div>
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
    <% for(let listing of allListings) { %>
        <div class="col">
            <a href="/listings/<%= listing._id %>" class="listing-link">
                <div class="card listing-card h-100">
                    <div class="card-img-wrapper">
                        <img
                            src="<%= listing.image ? listing.image.url : '' %>"
                            class="card-img-top"
                            alt="listing_image"
                            loading="lazy"
                        >
                    </div>
                    <div class="card-body">
                        <div class="listing-title"><%= listing.title %></div>
                        <div class="listing-price">
                            <span>&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : '0' %></span> / night
                            <i class="tax-Info">&nbsp;+18% GST</i>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    <% } %>
</div>

<script>
    let taxSwitch = document.getElementById("switchCheckDefault");
    if (taxSwitch) {
        taxSwitch.addEventListener("change", () => {
            let taxInfo = document.getElementsByClassName("tax-Info");
            for (let info of taxInfo) {
                if (taxSwitch.checked) {
                    info.style.display = "inline";
                } else {
                    info.style.display = "none";
                }
            }
        });
    }
</script>