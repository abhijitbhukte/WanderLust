<% layout("/layouts/boilerplate") %>
<script>
    const mapToken = "<%= process.env.MAPTILER_API_KEY %>";
    const listing = <%- JSON.stringify(listing) %>;
</script>

<div class="row mt-3">
    <div class="col-12 col-lg-8 offset-lg-2">
        <h2 class="fw-bold mb-3"><%= listing.title %></h2>
        
        <div class="card show-card mb-4">
            <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image">
            <div class="card-body mt-3">
                <div class="owner-badge">
                    <i class="fa-solid fa-user-check"></i> Hosted by <%= listing.owner ? listing.owner.username : 'Host' %>
                </div>
                <p class="card-text text-secondary mb-3"><%= listing.description %></p>
                <div class="d-flex align-items-center justify-content-between border-top pt-3">
                    <div>
                        <span class="fs-4 fw-bold text-dark">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : '0' %></span>
                        <span class="text-muted"> / night</span>
                    </div>
                    <div class="text-muted fw-semibold">
                        <i class="fa-solid fa-location-dot text-teal me-1"></i><%= listing.location %>, <%= listing.country %>
                    </div>
                </div>
            </div>
        </div>

        <% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
            <div class="d-flex gap-2 mb-4">
                <a href="/listings/<%= listing._id %>/edit" class="btn btn-teal">
                    <i class="fa-solid fa-pen-to-square me-1"></i> Edit Listing
                </a>
                <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                    <button class="btn btn-outline-danger">
                        <i class="fa-solid fa-trash me-1"></i> Delete Listing
                    </button>
                </form>
            </div>
        <% } %>

        <hr class="my-4"/>

        <% if(currUser) { %>
            <div class="form-card mb-4">
                <h4 class="fw-bold mb-3">Leave a Review</h4>
                <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
                    <div class="mb-3">
                        <label for="rating" class="form-label">Rating</label>
                        <fieldset class="starability-slot">
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset> 
                    </div>
                    <div class="mb-3">
                        <label for="comment" class="form-label">Comments</label>
                        <textarea
                            name="review[comment]"
                            id="comment"
                            rows="4"
                            class="form-control"
                            placeholder="Share details of your stay..."
                            required
                        ></textarea>
                        <div class="invalid-feedback">Please add comments for your review</div>
                    </div>
                    <button class="btn btn-teal">Submit Review</button>
                </form>
            </div>
        <% } %>

        <% if (listing.reviews && listing.reviews.length > 0) { %>
            <h4 class="fw-bold mb-3">All Reviews (<%= listing.reviews.length %>)</h4>
            <div class="row row-cols-1 row-cols-md-2 g-3 mb-4">
                <% for(review of listing.reviews) { %>
                    <div class="col">
                        <div class="review-card h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="fw-bold text-dark mb-1">@<%= review.author ? review.author.username : 'User' %></div>
                                <p class="starability-result mb-2" data-rating="<%= review.rating %>"></p> 
                                <p class="text-secondary small mb-3"><%= review.comment %></p>
                            </div>
                            <% if(currUser && review.author && review.author._id.equals(currUser._id)) { %>
                                <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                    <button class="btn btn-sm btn-outline-danger">Delete Review</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>

        <div class="mb-4">
            <h4 class="fw-bold mb-3">Where You'll Be</h4>
            <div id="map"></div>           
        </div>
    </div>
</div>

<script src="https://cdn.maptiler.com/maptiler-sdk-js/latest/maptiler-sdk.umd.min.js"></script>
<script src="/js/map.js"></script>
