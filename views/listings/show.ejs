<% layout("/layouts/boilerplate") %>
<div class="row">
    <div class="col-8 offset-3">
        <body>
    <h3><%= listing.title %></h3>
    <br>
    </div>
    <div class="card col-6 offset-3 show-card listing-card">
        <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image">
        <div class="card-body ">
        <p class="card-text">Owner: <i><%= listing.owner.username %></i></p>
        <p class="card-text"><%= listing.description %></p>
        <p class="card-text">&#8377;<%= listing.price.toLocaleString("en-IN") %></p>
        <p class="card-text"><%= listing.location %></p>
        <p class="card-text"><%= listing.country %></p>
    </div>
    </div>

    <div class="btns">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark col-1 edit-btn offset-3">Edit </a>
    <br><br>
    <form method="POST" action="/listings/<%= listing._id%>?_method=DELETE " >
        <button class="btn btn-dark col-1 offset-3" >Delete </button>
    </form>
    </div>


    <div class="col-8 offset-3 mb-3">
        <hr/>
        <h4>Leave a Review</h4>
        <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">
            <div class="mb-3 mt-3">
                <lable for="rating" class="form-label" >Rating</lable>
                <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range"/>
            </div>
            <div>
                <label for="comment" class="form-label" >Comments</label>
                <textarea
                name="review[comment]"
                id="comment"
                cols="30"
                row="5"
                class="form-control"
                required
                ></textarea>
                <div class="invalid-feedback">Please add some comment for review</div>
            </div><br>
            <button class="btn btn-outline-dark">Submit</button>
        </form>

        <hr>

        <h5><b>All Reviews</b></h5>
        <div class="row">
            <% for(review of listing.reviews) { %>
               <div class="card col-md-5 ms-3 mb-3">
                    <div class="card-body h-100">
                        <p class="card-title"><b>Abhijit</b></p>
                        <p class="card-text"> <%= review.comment %></p>
                        <p class="card-text"> <%= review.rating %> Stars</p>

                        <form class="mb-3" method="POST" action="/listings/<%=listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                            <button class="btn btn-sm btn-dark">Delete</button>
                        </form>
                    </div>
               </div>
            <% } %>
        </div>
    </div>
    
</body>


</div>
