<% layout("/layouts/boilerplate") %>
<body>
    <h3>Add Listing</h3>
    <form method="POST" action="/listings">
        <input name="listing[title]" placeholder="title" type="text"/>
        <br><br>
        <textarea name="listing[description]" placeholder="Enter description"></textarea>
        <br><br>
        <input name="listing[image]" placeholder="enter image URL/Link" type="text"/>
        <br><br>
        <input name="listing[price]" placeholder="price" type="number"/>
        <br><br>
        <input name="listing[location]" placeholder="location" type="text"/>
        <br><br>
        <input name="listing[country]" placeholder="country" type="text"/>
        <br><br>
        <button>Submit</button>      
    </form>
</body>
